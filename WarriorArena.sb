'' Warrior Arena Game - Prototype Arena (CoreWar Emulator)
'' By DaCodeDude
TextWindow.Title = "Warrior Arena - Alpha 0.0.3"
TextWindow.WriteLine("Warrior Arena - Alpha 0.0.3 (CoreWar Emulator)")
TextWindow.Pause()

numWarriors = 0
maxWarriors = 10 ''Max # of warriors that can be loaded into the arena.

'' Warrior Data Arrays
warrior_code = ""
warrior_length = ""
warrior_start_point = ""
warrior_exec_pointer = ""
warrior_alive = ""

'' Memory/Arena Size:
memorySize = 200

dir = Program.Directory
warrior_dir = dir + "\warriors\"

TextWindow.WriteLine("Loading Warriors from: " + warrior_dir)

For i = 1 To maxWarriors
  If (File.Exists(warrior_dir + "warrior" + i + ".txt")) Then
    numWarriors = i
    warrior_alive[i] = "True"

    warrior_file = warrior_dir + "warrior" + i + ".txt"

    filelength = 0
    thisLine = File.ReadLine(warrior_file, 1)
    While (Text.ConvertToUpperCase(thisLine) <> "END")
      filelength = filelength + 1
      warrior_code[i][filelength] = thisLine
      thisLine = File.ReadLine(warrior_file, filelength + 1)
    EndWhile

    warrior_length[i] = filelength
    TextWindow.WriteLine("Warrior " + i + " loaded with " + warrior_length[i] + " instructions.")
  Else
    Goto warriors_loaded
  EndIf
EndFor
warriors_loaded:

TextWindow.WriteLine(numWarriors + " warriors loaded.")
TextWindow.Pause()
TextWindow.Clear()

'' Create memory Arena and place warriors
For i = 1 To numWarriors
  '' Find a random, non-overlapping start point
  is_placed = "False"
  While (is_placed = "False")
    is_valid_placement = "True"
    ' Get a potential start point
    temp_start = Math.GetRandomNumber(memorySize)

    ' Rule 1: Prevent placement that wraps around the arena
    If (temp_start + warrior_length[i] > memorySize) Then
      is_valid_placement = "False"
    EndIf

    ' Rule 2: Check for overlaps with already placed warriors
    If (is_valid_placement = "True") Then
      new_start = temp_start
      new_end = temp_start + warrior_length[i]

      For j = 1 To (i - 1)
        other_start = warrior_start_point[j]
        other_end = other_start + warrior_length[j]

        ' Robust overlap check: (StartA < EndB) and (EndA > StartB)
        If (new_start < other_end And new_end > other_start) Then
          is_valid_placement = "False"
        EndIf
      EndFor
    EndIf

    ' If placement is valid, lock it in
    If (is_valid_placement = "True") Then
      warrior_start_point[i] = temp_start
      warrior_exec_pointer[i] = temp_start
      is_placed = "True"
    EndIf
  EndWhile

  TextWindow.WriteLine("Warrior " + i + " starting at " + warrior_start_point[i])
EndFor

TextWindow.Pause()

'' Initialize memory to all DAT 0, 0
For i = 1 To memorySize
  memory[i] = "DAT 0, 0"
EndFor

'' Load warrior code into memory
For i = 1 To numWarriors
  start = warrior_start_point[i]
  For j = 1 To warrior_length[i]
    address = start + j - 1
    ' Wrap address if it goes past memory size
    If (address > memorySize) Then
      address = address - memorySize
    EndIf
    memory[address] = warrior_code[i][j]
  EndFor
EndFor

'' Load rest of memory
While (tempnum <> memorySize)
  tempnum = tempnum + 1
  memory[tempnum] = "DAT 0, 0"
EndWhile

'' Verify memory [Debug, 2 lines]
TextWindow.WriteLine(memory)
TextWindow.WriteLine("")

'' Begin the running of the Virtual Memory and Code Interpreter.
percycle = 500 '' To be customizable as to run game at multiple speeds.
maxnumcycles = 2000 '' Maximum number of cycles a round.
numcycles = 0
current_warrior = 1
warriors_alive_count = numWarriors

While (numcycles < maxnumcycles And warriors_alive_count > 1)
  If (warrior_alive[current_warrior] = "True") Then
    exec_ptr = warrior_exec_pointer[current_warrior]
    instruction = memory[exec_ptr]

    '' For debugging
    'TextWindow.WriteLine("Cycle " + numcycles + ", Warrior " + current_warrior + " at " + exec_ptr + ": " + instruction)

    ExecWarriorCommand()

    '' Check if warrior died
    If (winlose <> "") Then
      warrior_alive[current_warrior] = "False"
      warriors_alive_count = warriors_alive_count - 1
      TextWindow.WriteLine(winlose)
      winlose = ""
    EndIf

    'TextWindow.Pause()
  EndIf
  
  '' Move to the next warrior
  current_warrior = current_warrior + 1
  If (current_warrior > numWarriors) Then
    current_warrior = 1
    numcycles = numcycles + 1
    'TextWindow.WriteLine("--- End of Cycle " + (numcycles-1) + " ---")
  EndIf
EndWhile

'' Announce winner
For i = 1 To numWarriors
  If (warrior_alive[i] = "True") Then
    TextWindow.WriteLine("Warrior " + i + " is the winner!")
    Goto end_game
  EndIf
EndFor
TextWindow.WriteLine("The game is a draw!")
end_game:


Sub ExecWarriorCommand
  '' Find command and execute instruction.
  code = Text.GetSubText(instruction, 1, 3)
  ABFetch = instruction

  If (code = "DAT") Then
    winlose = "Warrior " + current_warrior + " died by executing DAT"
  ElseIf (code = "NOP") Then
    warrior_exec_pointer[current_warrior] = warrior_exec_pointer[current_warrior] + 1
    address_to_wrap = warrior_exec_pointer[current_warrior]
    WrapAddress()
    warrior_exec_pointer[current_warrior] = wrapped_address
  ElseIf (code = "ADD") Then
    ADD()
  ElseIf (code = "SUB") Then
    SUB()
  ElseIf (code = "MUL") Then
    MUL()
  ElseIf (code = "DIV") Then
    DIV()
  ElseIf (code = "MOV") Then
    MOV()
  ElseIf (code = "JMP") Then
    JMP()
  ElseIf (code = "JMZ") Then
    JMZ()
  ElseIf (code = "JMG") Then
    JMG()
  ElseIf (code = "DJN") Then
    DJN()
  ElseIf (code = "SEQ") Then
    SEQ()
  ElseIf (code = "SNE") Then
    SNE()
  Else
    winlose = "Warrior " + current_warrior + " died by executing invalid code: '" + instruction + "'"
  EndIf
EndSub

Sub GetABValues
  '' Get the AValue and the BValue, also check for Type modifiers (*, #, @, etc...) for each value.

  ' Clear previous values
  AValue = ""
  BValue = ""
  AMode = ""
  BMode = ""

  full_instruction = ABFetch
  ' Assuming opcode is always 3 chars followed by a space.
  operands_part = Text.GetSubTextToEnd(full_instruction, 5)

  ' Trim leading space from operands_part
  While (Text.GetSubText(operands_part, 1, 1) = " ")
    operands_part = Text.GetSubTextToEnd(operands_part, 2)
  EndWhile

  ' Find the comma to separate A and B fields
  comma_pos = Text.GetIndexOf(operands_part, ",")

  if (comma_pos > 0) then
    AFieldStr = Text.GetSubText(operands_part, 1, comma_pos - 1)
    BFieldStr = Text.GetSubTextToEnd(operands_part, comma_pos + 1)
  else
    ' Handle instructions with only one operand (like JMP)
    AFieldStr = operands_part
    BFieldStr = ""
  endif

  ' Trim space, a bit of a hack in SB
  While (Text.GetSubText(AFieldStr, Text.GetLength(AFieldStr), 1) = " ")
    AFieldStr = Text.GetSubText(AFieldStr, 1, Text.GetLength(AFieldStr) - 1)
  EndWhile
  While (Text.GetSubText(BFieldStr, 1, 1) = " ")
    BFieldStr = Text.GetSubTextToEnd(BFieldStr, 2)
  EndWhile

  ' Parse A-field
  if (AFieldStr <> "") then
    first_char_A = Text.GetSubText(AFieldStr, 1, 1)
    if (first_char_A = "#" or first_char_A = "$" or first_char_A = "@" or first_char_A = "*") then
      AMode = first_char_A
      AValue = Text.GetSubTextToEnd(AFieldStr, 2)
    else
      AMode = "$" ' Default to direct addressing
      AValue = AFieldStr
    endif
  endif

  ' Parse B-field
  if (BFieldStr <> "") then
    first_char_B = Text.GetSubText(BFieldStr, 1, 1)
    if (first_char_B = "#" or first_char_B = "$" or first_char_B = "@" or first_char_B = "*") then
      BMode = first_char_B
      BValue = Text.GetSubTextToEnd(BFieldStr, 2)
    else
      BMode = "$" ' Default to direct addressing
      BValue = BFieldStr
    endif
  endif
EndSub

Sub ResolveAOperand
  A_IsImmediate = "False"
  A_Address = -1
  If (AMode = "#") Then
    A_IsImmediate = "True"
    A_ImmediateValue = AValue
  Else
    ' It's an address mode
    address_to_wrap = warrior_exec_pointer[current_warrior] + AValue
    WrapAddress()
    base_addr = wrapped_address

    If (AMode = "$") Then ' Direct
      A_Address = base_addr
    ElseIf (AMode = "@") Then ' B-field indirect
      pointer_instr = memory[base_addr]
      ABFetch = pointer_instr
      GetABValues()
      address_to_wrap = base_addr + BValue ' BValue from pointer_instr
      WrapAddress()
      A_Address = wrapped_address
    ElseIf (AMode = "*") Then ' A-field indirect
      pointer_instr = memory[base_addr]
      ABFetch = pointer_instr
      GetABValues()
      address_to_wrap = base_addr + AValue ' AValue from pointer_instr
      WrapAddress()
      A_Address = wrapped_address
    EndIf
  EndIf
EndSub

Sub ResolveBOperand
  B_IsImmediate = "False"
  B_Address = -1
  If (BMode = "#") Then
    B_IsImmediate = "True"
    B_ImmediateValue = BValue
  Else
    address_to_wrap = warrior_exec_pointer[current_warrior] + BValue
    WrapAddress()
    base_addr = wrapped_address

    If (BMode = "$") Then
      B_Address = base_addr
    ElseIf (BMode = "@") Then
      pointer_instr = memory[base_addr]
      ABFetch = pointer_instr
      GetABValues()
      address_to_wrap = base_addr + BValue
      WrapAddress()
      B_Address = wrapped_address
    ElseIf (BMode = "*") Then
      pointer_instr = memory[base_addr]
      ABFetch = pointer_instr
      GetABValues()
      address_to_wrap = base_addr + AValue
      WrapAddress()
      B_Address = wrapped_address
    EndIf
  EndIf
EndSub

Sub SEQ
  '' Skip next instruction if instructions are equal.
  GetABValues()
  ResolveAOperand()
  ResolveBOperand()

  If (A_IsImmediate = "True" or B_IsImmediate = "True") Then
    winlose = "Warrior 1 died, SEQ cannot compare immediate values"
    return
  EndIf

  sourceInstr = memory[A_Address]
  destInstr = memory[B_Address]

  If (sourceInstr = destInstr) Then
    warrior_exec_pointer[current_warrior] = warrior_exec_pointer[current_warrior] + 2
  Else
    warrior_exec_pointer[current_warrior] = warrior_exec_pointer[current_warrior] + 1
  EndIf

  address_to_wrap = warrior_exec_pointer[current_warrior]
  WrapAddress()
  warrior_exec_pointer[current_warrior] = wrapped_address
EndSub

Sub SNE
  '' Skip next instruction if instructions are not equal.
  GetABValues()
  ResolveAOperand()
  ResolveBOperand()

  If (A_IsImmediate = "True" or B_IsImmediate = "True") Then
    winlose = "Warrior 1 died, SNE cannot compare immediate values"
    return
  EndIf
  
  sourceInstr = memory[A_Address]
  destInstr = memory[B_Address]

  If (sourceInstr <> destInstr) Then
    warrior_exec_pointer[current_warrior] = warrior_exec_pointer[current_warrior] + 2
  Else
    warrior_exec_pointer[current_warrior] = warrior_exec_pointer[current_warrior] + 1
  EndIf

  address_to_wrap = warrior_exec_pointer[current_warrior]
  WrapAddress()
  warrior_exec_pointer[current_warrior] = wrapped_address
EndSub

Sub DJN
  '' Decrement B-field of target and jump if not zero.
  GetABValues()

  ' Resolve B operand (the one to decrement)
  ResolveBOperand()
  If (B_IsImmediate = "True") Then
    winlose = "Warrior 1 died, DJN cannot decrement an immediate value"
    return
  EndIf

  ' Get and decrement the B-field of the instruction at B_Address
  instr_to_mod = memory[B_Address]
  ABFetch = instr_to_mod
  GetABValues() ' Parses instr_to_mod
  old_B_val = BValue
  new_B_val = old_B_val - 1

  ' Update the instruction in memory
  ABEdit[1] = "b"
  ABEdit[2] = new_B_val
  Btemp = B_Address - warrior_exec_pointer[current_warrior] ' EditAB needs the offset
  EditAB()

  ' Conditional jump
  If (new_B_val <> 0) Then
    ' Condition met, now resolve jump offset from operand A.
    If (AMode = "#") Then
      offset = AValue
    Else
      ResolveAOperand()
      If (A_IsImmediate = "True") Then return
      instr = memory[A_Address]
      ABFetch = instr
      GetABValues()
      offset = BValue
    EndIf
    warrior_exec_pointer[current_warrior] = warrior_exec_pointer[current_warrior] + offset
  Else
    ' Condition not met, just advance to next instruction
    warrior_exec_pointer[current_warrior] = warrior_exec_pointer[current_warrior] + 1
  EndIf

  address_to_wrap = warrior_exec_pointer[current_warrior]
  WrapAddress()
  warrior_exec_pointer[current_warrior] = wrapped_address
EndSub

Sub WrapAddress
  ' Input: global "address_to_wrap"
  ' Output: global "wrapped_address"
  wrapped_address = address_to_wrap
  While (wrapped_address > memorySize)
    wrapped_address = wrapped_address - memorySize
  EndWhile
  While (wrapped_address < 1)
    wrapped_address = wrapped_address + memorySize
  EndWhile
EndSub

Sub EditAB
  '' Edit A or B value at given address.
  '' It uses global variables:
  '' Btemp: offset to the instruction to edit.
  '' ABEdit[1]: "a" or "b" to specify which field to edit.
  '' ABEdit[2]: the new value for the field.

  address_to_wrap = warrior_exec_pointer[current_warrior] + Btemp
  WrapAddress()
  targetAddress = wrapped_address

  instructionToEdit = memory[targetAddress]
  opcode = Text.GetSubText(instructionToEdit, 1, 3)

  ' We need to parse the original A and B fields of the instruction to be edited
  ABFetch = instructionToEdit
  GetABValues() ' This sets global AFieldStr and BFieldStr
  originalAField = AFieldStr
  originalBField = BFieldStr

  If (ABEdit[1] = "a") Then
    ' Edit A-field. The new value in ABEdit[2] should be the full field string.
    newInstruction = opcode + " " + ABEdit[2] + ", " + originalBField
  Else
    ' Edit B-field. The new value in ABEdit[2] is just a number.
    ' The B-field in Redcode does not have a mode prefix.
    newInstruction = opcode + " " + originalAField + ", " + ABEdit[2]
  EndIf

  memory[targetAddress] = newInstruction
EndSub

Sub ADD
  '' Add command function.
  GetABValues()
  ResolveAOperand()
  ResolveBOperand()

  If (B_IsImmediate = "True") Then
    winlose = "Warrior 1 died due to invalid ADD destination"
    return
  EndIf

  ' Get source value
  If (A_IsImmediate = "True") Then
    sourceValue = A_ImmediateValue
  Else
    sourceInstr = memory[A_Address]
    ABFetch = sourceInstr
    GetABValues() ' This gets the B-value of the source instruction
    sourceValue = BValue
  EndIf

  ' Get dest value
  destInstr = memory[B_Address]
  ABFetch = destInstr
  GetABValues() ' This gets the B-value of the destination instruction
  destValue = BValue

  ' Calc new value
  newValue = destValue + sourceValue

  ' Update dest
  ABEdit[1] = "b"
  ABEdit[2] = newValue
  Btemp = B_Address - warrior_exec_pointer[current_warrior] ' EditAB needs the offset
  EditAB()

  warrior_exec_pointer[current_warrior] = warrior_exec_pointer[current_warrior] + 1
  address_to_wrap = warrior_exec_pointer[current_warrior]
  WrapAddress()
  warrior_exec_pointer[current_warrior] = wrapped_address
EndSub

Sub SUB
  '' Subtract command function
  GetABValues()
  ResolveAOperand()
  ResolveBOperand()

  If (B_IsImmediate = "True") Then
    winlose = "Warrior 1 died due to invalid SUB destination"
    return
  EndIf

  ' Get source value
  If (A_IsImmediate = "True") Then
    sourceValue = A_ImmediateValue
  Else
    sourceInstr = memory[A_Address]
    ABFetch = sourceInstr
    GetABValues()
    sourceValue = BValue
  EndIf

  ' Get dest value
  destInstr = memory[B_Address]
  ABFetch = destInstr
  GetABValues()
  destValue = BValue

  ' Calc new value
  newValue = destValue - sourceValue

  ' Update dest
  ABEdit[1] = "b"
  ABEdit[2] = newValue
  Btemp = B_Address - warrior_exec_pointer[current_warrior]
  EditAB()

  warrior_exec_pointer[current_warrior] = warrior_exec_pointer[current_warrior] + 1
  address_to_wrap = warrior_exec_pointer[current_warrior]
  WrapAddress()
  warrior_exec_pointer[current_warrior] = wrapped_address
EndSub

Sub MUL
  '' Multiply command function.
  GetABValues()
  ResolveAOperand()
  ResolveBOperand()

  If (B_IsImmediate = "True") Then
    winlose = "Warrior 1 died due to invalid MUL destination"
    return
  EndIf

  ' Get source value
  If (A_IsImmediate = "True") Then
    sourceValue = A_ImmediateValue
  Else
    sourceInstr = memory[A_Address]
    ABFetch = sourceInstr
    GetABValues()
    sourceValue = BValue
  EndIf

  ' Get dest value
  destInstr = memory[B_Address]
  ABFetch = destInstr
  GetABValues()
  destValue = BValue

  ' Calc new value
  newValue = destValue * sourceValue

  ' Update dest
  ABEdit[1] = "b"
  ABEdit[2] = newValue
  Btemp = B_Address - warrior_exec_pointer[current_warrior]
  EditAB()

  warrior_exec_pointer[current_warrior] = warrior_exec_pointer[current_warrior] + 1
  address_to_wrap = warrior_exec_pointer[current_warrior]
  WrapAddress()
  warrior_exec_pointer[current_warrior] = wrapped_address
EndSub

Sub DIV
  '' Divide command function.
  GetABValues()
  ResolveAOperand()
  ResolveBOperand()

  If (B_IsImmediate = "True") Then
    winlose = "Warrior 1 died due to invalid DIV destination"
    return
  EndIf

  ' Get source value
  If (A_IsImmediate = "True") Then
    sourceValue = A_ImmediateValue
  Else
    sourceInstr = memory[A_Address]
    ABFetch = sourceInstr
    GetABValues()
    sourceValue = BValue
  EndIf

  ' Get dest value
  destInstr = memory[B_Address]
  ABFetch = destInstr
  GetABValues()
  destValue = BValue

  ' Calc new value
  If (sourceValue <> 0) Then
    newValue = Math.Floor(destValue / sourceValue)
  Else
    ' Division by zero kills the process
    winlose = "Warrior 1 died due to division by zero"
    return
  EndIf

  ' Update dest
  ABEdit[1] = "b"
  ABEdit[2] = newValue
  Btemp = B_Address - warrior_exec_pointer[current_warrior]
  EditAB()

  warrior_exec_pointer[current_warrior] = warrior_exec_pointer[current_warrior] + 1
  address_to_wrap = warrior_exec_pointer[current_warrior]
  WrapAddress()
  warrior_exec_pointer[current_warrior] = wrapped_address
EndSub

Sub MOV
  '' Move command function.
  GetABValues()
  ResolveAOperand()
  ResolveBOperand()

  If (B_IsImmediate = "True") Then
    ' Can't move to an immediate value.
    ' This is an error condition. For now, we'll just stop the warrior.
    winlose = "Warrior 1 died due to invalid MOV destination"
    return
  EndIf

  ' Get the source instruction
  If (A_IsImmediate = "True") Then
    ' A common interpretation of MOV with an immediate source is to treat it as MOV.I,
    ' which copies the A-field value into the B-field of the destination.
    ' However, a simpler interpretation for this emulator is to create a DAT instruction.
    sourceInstr = "DAT #0, " + A_ImmediateValue
  Else
    sourceInstr = memory[A_Address]
  EndIf

  ' Perform the move
  memory[B_Address] = sourceInstr

  warrior_exec_pointer[current_warrior] = warrior_exec_pointer[current_warrior] + 1
  address_to_wrap = warrior_exec_pointer[current_warrior]
  WrapAddress()
  warrior_exec_pointer[current_warrior] = wrapped_address
EndSub

Sub JMP
  '' Jump to a new address.
  GetABValues()

  ' Resolve the jump offset value from operand A.
  If (AMode = "#") Then
    offset = AValue
  Else ' Direct, indirect etc.
    ResolveAOperand()
    If (A_IsImmediate = "True") Then return ' Should not happen

    ' The offset is the B-field of the instruction at the target address
    instr = memory[A_Address]
    ABFetch = instr
    GetABValues()
    offset = BValue
  EndIf

  warrior_exec_pointer[current_warrior] = warrior_exec_pointer[current_warrior] + offset
  address_to_wrap = warrior_exec_pointer[current_warrior]
  WrapAddress()
  warrior_exec_pointer[current_warrior] = wrapped_address
EndSub

Sub JMZ
  '' Jump if B-field of target is zero.
  GetABValues()

  ' Resolve B operand (the one to check)
  ResolveBOperand()
  If (B_IsImmediate = "True") Then
    winlose = "Warrior 1 died, JMZ cannot check an immediate value"
    return
  EndIf

  ' Check the B-field of the instruction at B_Address
  instr_to_check = memory[B_Address]
  ABFetch = instr_to_check
  GetABValues() ' Parses instr_to_check
  value_to_check = BValue

  If (value_to_check = 0) Then
    ' Condition met, now resolve jump offset from operand A.
    If (AMode = "#") Then
      offset = AValue
    Else
      ResolveAOperand()
      If (A_IsImmediate = "True") Then return
      instr = memory[A_Address]
      ABFetch = instr
      GetABValues()
      offset = BValue
    EndIf
    warrior_exec_pointer[current_warrior] = warrior_exec_pointer[current_warrior] + offset
  Else
    ' Condition not met, just advance to next instruction
    warrior_exec_pointer[current_warrior] = warrior_exec_pointer[current_warrior] + 1
  EndIf

  address_to_wrap = warrior_exec_pointer[current_warrior]
  WrapAddress()
  warrior_exec_pointer[current_warrior] = wrapped_address
EndSub

Sub JMG
  '' Jump if B-field of target is greater than zero.
  GetABValues()

  ' Resolve B operand (the one to check)
  ResolveBOperand()
  If (B_IsImmediate = "True") Then
    winlose = "Warrior 1 died, JMG cannot check an immediate value"
    return
  EndIf

  ' Check the B-field of the instruction at B_Address
  instr_to_check = memory[B_Address]
  ABFetch = instr_to_check
  GetABValues() ' Parses instr_to_check
  value_to_check = BValue

  If (value_to_check > 0) Then
    ' Condition met, now resolve jump offset from operand A.
    If (AMode = "#") Then
      offset = AValue
    Else
      ResolveAOperand()
      If (A_IsImmediate = "True") Then return
      instr = memory[A_Address]
      ABFetch = instr
      GetABValues()
      offset = BValue
    EndIf
    warrior_exec_pointer[current_warrior] = warrior_exec_pointer[current_warrior] + offset
  Else
    ' Condition not met, just advance to next instruction
    warrior_exec_pointer[current_warrior] = warrior_exec_pointer[current_warrior] + 1
  EndIf

  address_to_wrap = warrior_exec_pointer[current_warrior]
  WrapAddress()
  warrior_exec_pointer[current_warrior] = wrapped_address
EndSub
