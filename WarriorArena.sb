'' Warrior Arena Game - Prototype Arena (CoreWar Emulator)
'' By DaCodeDude
TextWindow.Title = "Warrior Arena - Alpha 0.0.3"
TextWindow.WriteLine("Warrior Arena - Alpha 0.0.3 (CoreWar Emulator)")
TextWindow.Pause()

'' Not Implemented Yet:
'' Hard core players don't need or use this anyways :P
'' warrior1 private memory
''warrior1priv[1] = ""
''warrior1priv[2] = ""
''warrior1priv[3] = ""
''warrior1priv[4] = ""

'' Memory/Arena Size:
memorySize = 100

dir = Program.Directory

TextWindow.WriteLine("Warrior Loading:")
'' Open Warrior1 - Replaced with input via Arguments.
''warrior1file = "C:\WarriorArena\warriors\warrior1.txt"

'' Opens test warriors for program testing and debugging, or just for basic game demo.
If (warrior1file = "") Then
  warrior1file = dir + "\warriors\warrior1.txt"
EndIf
warrior1code = ""
filelength = 0

'' Load each line of warrior 1's code into temporary array
thisLine = File.ReadLine(warrior1file, 1)
While (thisLine <> "End")
  filelength = filelength + 1
  warrior1code[filelength] = thisLine
  thisLine = File.ReadLine(warrior1file, filelength + 1)
EndWhile

'' Check warrior 1 data [Debug, 2 lines]
TextWindow.WriteLine("Warrior 1: " + warrior1code)
TextWindow.WriteLine("")

'' Get warrior 1's # of commands
warrior1length = Array.GetItemCount(warrior1code)

'' Verify # of commands in warrior 1 [Debug, 2 lines]
TextWindow.WriteLine(warrior1length)
TextWindow.WriteLine("")


'' Create memory Arena
warrior1startpoint = 1

'' Verify startpoint for warrior 1 [Debug, 2 lines]
TextWindow.WriteLine("Warrior 1 start point: " + warrior1startpoint + ".")
TextWindow.WriteLine("")

'' Load warrior 1 commands into memory array from its array.
tempnum = 0
While (tempnum <> warrior1length)
  tempnum = tempnum + 1
  memory[tempnum] = warrior1code[tempnum]
EndWhile

'' Load rest of memory
While (tempnum <> memorySize)
  tempnum = tempnum + 1
  memory[tempnum] = "DAT 0, 0"
EndWhile

'' Verify memory [Debug, 2 lines]
TextWindow.WriteLine(memory)
TextWindow.WriteLine("")

'' Begin the running of the Virtual Memory and Code Interpreter.
percycle = 500 '' To be customizable as to run game at multiple speeds. i.e. for watching a warrior for debugging/testing or running fast for quick tournement runs.
maxnumcycles = 1000 '' Maximum number of cycles a round, also customizable.
numcycles = 0
warrior1exec = warrior1startpoint '' warrior1exec is the next execution point, here is initializes as the start point of warrior 1.
'' Remember, warrior1startpoint is also the warrior's program execution start point.
While (numcycles <> maxnumcycles)
  warrior1step = memory[warrior1exec] '' Load warrior 1 command from memory array.
  '' Verify each command to run [Debug, 1 line]
  TextWindow.WriteLine(warrior1step)
  
  ExecWarrior1Command()
  numcycles = numcycles + 1
  '' Verify memory [Debug, 3 lines]
  TextWindow.WriteLine(memory)
  TextWindow.WriteLine("")
  TextWindow.Pause()
EndWhile

Sub ExecWarrior1Command
  '' Find command and execute instruction relating to the command. Command modifiers and other non-math related commands are not yet implemented.
  code = Text.GetSubText(warrior1step, 1, 3)
  ABFetch = warrior1step
  If (code = "DAT") Then '' Check for process destruction command.
    winlose = "Warrior 1 died"
  ElseIf (code = "NOP") Then '' Check for do nothing command.
    warrior1exec = warrior1exec + 1
    address_to_wrap = warrior1exec
    WrapAddress()
    warrior1exec = wrapped_address
  ElseIf (code = "ADD") Then '' Check for varriable adding command.
    ADD()
  ElseIf (code = "SUB") Then '' Check for variable subtracting command.
    SUB()
  ElseIf (code = "MUL") Then '' Check for variable muliplying command.
    MUL()
  ElseIf (code = "DIV") Then '' Check for variable dividing command.
    DIV()
  ElseIf (code = "MOV") Then '' Check for move command.
    MOV()
  ElseIf (code = "JMP") Then '' Check for jump command.
    JMP()
  ElseIf (code = "JMZ") Then '' Check for jump if zero command.
    JMZ()
  ElseIf (code = "JMG") Then '' Check for jump if greater command.
    JMG()
  ElseIf (code = "DJN") Then '' Check for decrement and jump if not zero command.
    DJN()
  ElseIf (code = "SEQ") Then '' Check for skip if equal command.
    SEQ()
  ElseIf (code = "SNE") Then '' Check for skip if not equal command.
    SNE()
  Else '' Catchall for unkown data
    TextWindow.WriteLine("Memory Array Error: Incompatible Data: '" + warrior1step + "'")
    TextWindow.WriteLine("Error Causes: (Incorrect Warrior Code) or (Program Error).")
  EndIf
  TextWindow.Pause()
EndSub

Sub GetABValues
  '' Get the AValue and the BValue, also check for Type modifiers (*, #, @, etc...) for each value.

  ' Clear previous values
  AValue = ""
  BValue = ""
  AMode = ""
  BMode = ""

  full_instruction = ABFetch
  ' Assuming opcode is always 3 chars followed by a space.
  operands_part = Text.GetSubTextToEnd(full_instruction, 5)

  ' Trim leading space from operands_part
  While (Text.GetSubText(operands_part, 1, 1) = " ")
    operands_part = Text.GetSubTextToEnd(operands_part, 2)
  EndWhile

  ' Find the comma to separate A and B fields
  comma_pos = Text.GetIndexOf(operands_part, ",")

  if (comma_pos > 0) then
    AFieldStr = Text.GetSubText(operands_part, 1, comma_pos - 1)
    BFieldStr = Text.GetSubTextToEnd(operands_part, comma_pos + 1)
  else
    ' Handle instructions with only one operand (like JMP)
    AFieldStr = operands_part
    BFieldStr = ""
  endif

  ' Trim space, a bit of a hack in SB
  While (Text.GetSubText(AFieldStr, Text.GetLength(AFieldStr), 1) = " ")
    AFieldStr = Text.GetSubText(AFieldStr, 1, Text.GetLength(AFieldStr) - 1)
  EndWhile
  While (Text.GetSubText(BFieldStr, 1, 1) = " ")
    BFieldStr = Text.GetSubTextToEnd(BFieldStr, 2)
  EndWhile

  ' Parse A-field
  if (AFieldStr <> "") then
    first_char_A = Text.GetSubText(AFieldStr, 1, 1)
    if (first_char_A = "#" or first_char_A = "$" or first_char_A = "@" or first_char_A = "*") then
      AMode = first_char_A
      AValue = Text.GetSubTextToEnd(AFieldStr, 2)
    else
      AMode = "$" ' Default to direct addressing
      AValue = AFieldStr
    endif
  endif

  ' Parse B-field
  if (BFieldStr <> "") then
    first_char_B = Text.GetSubText(BFieldStr, 1, 1)
    if (first_char_B = "#" or first_char_B = "$" or first_char_B = "@" or first_char_B = "*") then
      BMode = first_char_B
      BValue = Text.GetSubTextToEnd(BFieldStr, 2)
    else
      BMode = "$" ' Default to direct addressing
      BValue = BFieldStr
    endif
  endif
EndSub

Sub ResolveAOperand
  A_IsImmediate = "False"
  A_Address = -1
  If (AMode = "#") Then
    A_IsImmediate = "True"
    A_ImmediateValue = AValue
  Else
    ' It's an address mode
    address_to_wrap = warrior1exec + AValue
    WrapAddress()
    base_addr = wrapped_address

    If (AMode = "$") Then ' Direct
      A_Address = base_addr
    ElseIf (AMode = "@") Then ' B-field indirect
      pointer_instr = memory[base_addr]
      ABFetch = pointer_instr
      GetABValues()
      address_to_wrap = base_addr + BValue ' BValue from pointer_instr
      WrapAddress()
      A_Address = wrapped_address
    ElseIf (AMode = "*") Then ' A-field indirect
      pointer_instr = memory[base_addr]
      ABFetch = pointer_instr
      GetABValues()
      address_to_wrap = base_addr + AValue ' AValue from pointer_instr
      WrapAddress()
      A_Address = wrapped_address
    EndIf
  EndIf
EndSub

Sub ResolveBOperand
  B_IsImmediate = "False"
  B_Address = -1
  If (BMode = "#") Then
    B_IsImmediate = "True"
    B_ImmediateValue = BValue
  Else
    address_to_wrap = warrior1exec + BValue
    WrapAddress()
    base_addr = wrapped_address

    If (BMode = "$") Then
      B_Address = base_addr
    ElseIf (BMode = "@") Then
      pointer_instr = memory[base_addr]
      ABFetch = pointer_instr
      GetABValues()
      address_to_wrap = base_addr + BValue
      WrapAddress()
      B_Address = wrapped_address
    ElseIf (BMode = "*") Then
      pointer_instr = memory[base_addr]
      ABFetch = pointer_instr
      GetABValues()
      address_to_wrap = base_addr + AValue
      WrapAddress()
      B_Address = wrapped_address
    EndIf
  EndIf
EndSub

Sub SEQ
  '' Skip next instruction if instructions are equal.
  GetABValues()
  ResolveAOperand()
  ResolveBOperand()

  If (A_IsImmediate = "True" or B_IsImmediate = "True") Then
    winlose = "Warrior 1 died, SEQ cannot compare immediate values"
    return
  EndIf

  sourceInstr = memory[A_Address]
  destInstr = memory[B_Address]

  If (sourceInstr = destInstr) Then
    warrior1exec = warrior1exec + 2
  Else
    warrior1exec = warrior1exec + 1
  EndIf

  address_to_wrap = warrior1exec
  WrapAddress()
  warrior1exec = wrapped_address
EndSub

Sub SNE
  '' Skip next instruction if instructions are not equal.
  GetABValues()
  ResolveAOperand()
  ResolveBOperand()

  If (A_IsImmediate = "True" or B_IsImmediate = "True") Then
    winlose = "Warrior 1 died, SNE cannot compare immediate values"
    return
  EndIf
  
  sourceInstr = memory[A_Address]
  destInstr = memory[B_Address]

  If (sourceInstr <> destInstr) Then
    warrior1exec = warrior1exec + 2
  Else
    warrior1exec = warrior1exec + 1
  EndIf

  address_to_wrap = warrior1exec
  WrapAddress()
  warrior1exec = wrapped_address
EndSub

Sub DJN
  '' Decrement B-field of target and jump if not zero.
  GetABValues()

  ' Resolve B operand (the one to decrement)
  ResolveBOperand()
  If (B_IsImmediate = "True") Then
    winlose = "Warrior 1 died, DJN cannot decrement an immediate value"
    return
  EndIf

  ' Get and decrement the B-field of the instruction at B_Address
  instr_to_mod = memory[B_Address]
  ABFetch = instr_to_mod
  GetABValues() ' Parses instr_to_mod
  old_B_val = BValue
  new_B_val = old_B_val - 1

  ' Update the instruction in memory
  ABEdit[1] = "b"
  ABEdit[2] = new_B_val
  Btemp = B_Address - warrior1exec ' EditAB needs the offset
  EditAB()

  ' Conditional jump
  If (new_B_val <> 0) Then
    ' Condition met, now resolve jump offset from operand A.
    If (AMode = "#") Then
      offset = AValue
    Else
      ResolveAOperand()
      If (A_IsImmediate = "True") Then return
      instr = memory[A_Address]
      ABFetch = instr
      GetABValues()
      offset = BValue
    EndIf
    warrior1exec = warrior1exec + offset
  Else
    ' Condition not met, just advance to next instruction
    warrior1exec = warrior1exec + 1
  EndIf

  address_to_wrap = warrior1exec
  WrapAddress()
  warrior1exec = wrapped_address
EndSub

Sub WrapAddress
  ' Input: global "address_to_wrap"
  ' Output: global "wrapped_address"
  wrapped_address = address_to_wrap
  While (wrapped_address > memorySize)
    wrapped_address = wrapped_address - memorySize
  EndWhile
  While (wrapped_address < 1)
    wrapped_address = wrapped_address + memorySize
  EndWhile
EndSub

Sub EditAB
  '' Edit A or B value at given address.
  '' It uses global variables:
  '' Btemp: offset to the instruction to edit.
  '' ABEdit[1]: "a" or "b" to specify which field to edit.
  '' ABEdit[2]: the new value for the field.

  address_to_wrap = warrior1exec + Btemp
  WrapAddress()
  targetAddress = wrapped_address

  instructionToEdit = memory[targetAddress]
  opcode = Text.GetSubText(instructionToEdit, 1, 3)

  ' We need to parse the original A and B fields of the instruction to be edited
  ABFetch = instructionToEdit
  GetABValues() ' This sets global AFieldStr and BFieldStr
  originalAField = AFieldStr
  originalBField = BFieldStr

  If (ABEdit[1] = "a") Then
    ' Edit A-field. The new value in ABEdit[2] should be the full field string.
    newInstruction = opcode + " " + ABEdit[2] + ", " + originalBField
  Else
    ' Edit B-field. The new value in ABEdit[2] is just a number.
    ' The B-field in Redcode does not have a mode prefix.
    newInstruction = opcode + " " + originalAField + ", " + ABEdit[2]
  EndIf

  memory[targetAddress] = newInstruction
EndSub

Sub ADD
  '' Add command function.
  GetABValues()
  ResolveAOperand()
  ResolveBOperand()

  If (B_IsImmediate = "True") Then
    winlose = "Warrior 1 died due to invalid ADD destination"
    return
  EndIf

  ' Get source value
  If (A_IsImmediate = "True") Then
    sourceValue = A_ImmediateValue
  Else
    sourceInstr = memory[A_Address]
    ABFetch = sourceInstr
    GetABValues() ' This gets the B-value of the source instruction
    sourceValue = BValue
  EndIf

  ' Get dest value
  destInstr = memory[B_Address]
  ABFetch = destInstr
  GetABValues() ' This gets the B-value of the destination instruction
  destValue = BValue

  ' Calc new value
  newValue = destValue + sourceValue

  ' Update dest
  ABEdit[1] = "b"
  ABEdit[2] = newValue
  Btemp = B_Address - warrior1exec ' EditAB needs the offset
  EditAB()

  warrior1exec = warrior1exec + 1
  address_to_wrap = warrior1exec
  WrapAddress()
  warrior1exec = wrapped_address
EndSub

Sub SUB
  '' Subtract command function
  GetABValues()
  ResolveAOperand()
  ResolveBOperand()

  If (B_IsImmediate = "True") Then
    winlose = "Warrior 1 died due to invalid SUB destination"
    return
  EndIf

  ' Get source value
  If (A_IsImmediate = "True") Then
    sourceValue = A_ImmediateValue
  Else
    sourceInstr = memory[A_Address]
    ABFetch = sourceInstr
    GetABValues()
    sourceValue = BValue
  EndIf

  ' Get dest value
  destInstr = memory[B_Address]
  ABFetch = destInstr
  GetABValues()
  destValue = BValue

  ' Calc new value
  newValue = destValue - sourceValue

  ' Update dest
  ABEdit[1] = "b"
  ABEdit[2] = newValue
  Btemp = B_Address - warrior1exec
  EditAB()

  warrior1exec = warrior1exec + 1
  address_to_wrap = warrior1exec
  WrapAddress()
  warrior1exec = wrapped_address
EndSub

Sub MUL
  '' Multiply command function.
  GetABValues()
  ResolveAOperand()
  ResolveBOperand()

  If (B_IsImmediate = "True") Then
    winlose = "Warrior 1 died due to invalid MUL destination"
    return
  EndIf

  ' Get source value
  If (A_IsImmediate = "True") Then
    sourceValue = A_ImmediateValue
  Else
    sourceInstr = memory[A_Address]
    ABFetch = sourceInstr
    GetABValues()
    sourceValue = BValue
  EndIf

  ' Get dest value
  destInstr = memory[B_Address]
  ABFetch = destInstr
  GetABValues()
  destValue = BValue

  ' Calc new value
  newValue = destValue * sourceValue

  ' Update dest
  ABEdit[1] = "b"
  ABEdit[2] = newValue
  Btemp = B_Address - warrior1exec
  EditAB()

  warrior1exec = warrior1exec + 1
  address_to_wrap = warrior1exec
  WrapAddress()
  warrior1exec = wrapped_address
EndSub

Sub DIV
  '' Divide command function.
  GetABValues()
  ResolveAOperand()
  ResolveBOperand()

  If (B_IsImmediate = "True") Then
    winlose = "Warrior 1 died due to invalid DIV destination"
    return
  EndIf

  ' Get source value
  If (A_IsImmediate = "True") Then
    sourceValue = A_ImmediateValue
  Else
    sourceInstr = memory[A_Address]
    ABFetch = sourceInstr
    GetABValues()
    sourceValue = BValue
  EndIf

  ' Get dest value
  destInstr = memory[B_Address]
  ABFetch = destInstr
  GetABValues()
  destValue = BValue

  ' Calc new value
  If (sourceValue <> 0) Then
    newValue = Math.Floor(destValue / sourceValue)
  Else
    ' Division by zero kills the process
    winlose = "Warrior 1 died due to division by zero"
    return
  EndIf

  ' Update dest
  ABEdit[1] = "b"
  ABEdit[2] = newValue
  Btemp = B_Address - warrior1exec
  EditAB()

  warrior1exec = warrior1exec + 1
  address_to_wrap = warrior1exec
  WrapAddress()
  warrior1exec = wrapped_address
EndSub

Sub MOV
  '' Move command function.
  GetABValues()
  ResolveAOperand()
  ResolveBOperand()

  If (B_IsImmediate = "True") Then
    ' Can't move to an immediate value.
    ' This is an error condition. For now, we'll just stop the warrior.
    winlose = "Warrior 1 died due to invalid MOV destination"
    return
  EndIf

  ' Get the source instruction
  If (A_IsImmediate = "True") Then
    ' A common interpretation of MOV with an immediate source is to treat it as MOV.I,
    ' which copies the A-field value into the B-field of the destination.
    ' However, a simpler interpretation for this emulator is to create a DAT instruction.
    sourceInstr = "DAT #0, " + A_ImmediateValue
  Else
    sourceInstr = memory[A_Address]
  EndIf

  ' Perform the move
  memory[B_Address] = sourceInstr

  warrior1exec = warrior1exec + 1
  address_to_wrap = warrior1exec
  WrapAddress()
  warrior1exec = wrapped_address
EndSub

Sub JMP
  '' Jump to a new address.
  GetABValues()

  ' Resolve the jump offset value from operand A.
  If (AMode = "#") Then
    offset = AValue
  Else ' Direct, indirect etc.
    ResolveAOperand()
    If (A_IsImmediate = "True") Then return ' Should not happen

    ' The offset is the B-field of the instruction at the target address
    instr = memory[A_Address]
    ABFetch = instr
    GetABValues()
    offset = BValue
  EndIf

  warrior1exec = warrior1exec + offset
  address_to_wrap = warrior1exec
  WrapAddress()
  warrior1exec = wrapped_address
EndSub

Sub JMZ
  '' Jump if B-field of target is zero.
  GetABValues()

  ' Resolve B operand (the one to check)
  ResolveBOperand()
  If (B_IsImmediate = "True") Then
    winlose = "Warrior 1 died, JMZ cannot check an immediate value"
    return
  EndIf

  ' Check the B-field of the instruction at B_Address
  instr_to_check = memory[B_Address]
  ABFetch = instr_to_check
  GetABValues() ' Parses instr_to_check
  value_to_check = BValue

  If (value_to_check = 0) Then
    ' Condition met, now resolve jump offset from operand A.
    If (AMode = "#") Then
      offset = AValue
    Else
      ResolveAOperand()
      If (A_IsImmediate = "True") Then return
      instr = memory[A_Address]
      ABFetch = instr
      GetABValues()
      offset = BValue
    EndIf
    warrior1exec = warrior1exec + offset
  Else
    ' Condition not met, just advance to next instruction
    warrior1exec = warrior1exec + 1
  EndIf

  address_to_wrap = warrior1exec
  WrapAddress()
  warrior1exec = wrapped_address
EndSub

Sub JMG
  '' Jump if B-field of target is greater than zero.
  GetABValues()

  ' Resolve B operand (the one to check)
  ResolveBOperand()
  If (B_IsImmediate = "True") Then
    winlose = "Warrior 1 died, JMG cannot check an immediate value"
    return
  EndIf

  ' Check the B-field of the instruction at B_Address
  instr_to_check = memory[B_Address]
  ABFetch = instr_to_check
  GetABValues() ' Parses instr_to_check
  value_to_check = BValue

  If (value_to_check > 0) Then
    ' Condition met, now resolve jump offset from operand A.
    If (AMode = "#") Then
      offset = AValue
    Else
      ResolveAOperand()
      If (A_IsImmediate = "True") Then return
      instr = memory[A_Address]
      ABFetch = instr
      GetABValues()
      offset = BValue
    EndIf
    warrior1exec = warrior1exec + offset
  Else
    ' Condition not met, just advance to next instruction
    warrior1exec = warrior1exec + 1
  EndIf

  address_to_wrap = warrior1exec
  WrapAddress()
  warrior1exec = wrapped_address
EndSub
